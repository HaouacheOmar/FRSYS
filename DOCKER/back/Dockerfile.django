FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Added libstdc++6 to support onnxruntime execution initialization
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    cmake \
    libpq-dev \
    ffmpeg \
    libgomp1 \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt

# Bootstrap build utilities
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
# Force install onnxruntime dynamically right before requirements 
RUN pip install --no-cache-dir onnxruntime
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app

EXPOSE 8000

CMD ["sh", "-c", "python manage.py migrate && daphne -b 0.0.0.0 -p 8000 FRSYS.asgi:application"]