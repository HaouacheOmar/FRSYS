# Copy to .env (git-ignored). Read by app.py.

# Root of the face photos (<FACE_DB_PATH>/<mat>/main.jpg). Same value as Django's.
# Photos are loaded at startup: restart this server after adding photos.
FACE_DB_PATH=/data/faces

# Shared secret: Django must send the same value (MODEL_SERVER_TOKEN in DJANGO_SERVER/.env).
# Empty = no check (local development only).
MODEL_SERVER_TOKEN=

# Only Django calls this server. Keep 127.0.0.1 when both run on the same PC.
MODEL_SERVER_HOST=127.0.0.1
