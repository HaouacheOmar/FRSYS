# Copy to .env (git-ignored). Read by Vite at build/dev time (src/services/api.js, vite.config.js).

# Django API on the Administration PC. If unset: http://<this page's host>:8000/api
VITE_API_BASE_URL=http://192.168.1.100:8000/api
# Django WebSockets. If unset: ws://<this page's host>:8000
VITE_WS_URL=ws://192.168.1.100:8000

# Target of the Vite dev server's /api and /ws proxy (npm run dev only).
VITE_BACKEND_IP=192.168.1.100
VITE_BACKEND_PORT=8000
VITE_APP_NAME=FR Surveillance Client

# This page's address (e.g. http://192.168.1.10:3000) must be listed in Django's
# CORS_ALLOWED_ORIGINS, or login, writes and the video stream are refused.
