# Copy to .env (git-ignored) and fill in. Read by FRSYS/settings.py.

# --- Required -----------------------------------------------------------------
# Signs every login token. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Django refuses to start with a short/placeholder key unless DEBUG=1.
SECRET_KEY=

# Never 1 in production (shows debug pages, allows the localhost:3000 dev origin).
DEBUG=0

# Host names / IPs this server answers to (the Administration PC's address).
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

# Every address the frontend is opened from (scheme + host + port). This one list drives
# CORS, CSRF and the WebSocket origin check: a post missing here can't log in or stream.
CORS_ALLOWED_ORIGINS=http://192.168.1.10:3000,http://192.168.1.11:3000
# Optional, defaults to CORS_ALLOWED_ORIGINS.
# CSRF_TRUSTED_ORIGINS=

# PostgreSQL
DB_NAME=FRSYS_DB
DB_USER=frsys
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Face recognition -------------------------------------------------------------
# Root of the face photos (<FACE_DB_PATH>/<mat>/main.jpg). Same value as MODEL_SERVER's.
FACE_DB_PATH=/data/faces
MODEL_SERVER_URL=http://localhost:5000
# Shared secret with the model server (same value in MODEL_SERVER/.env). Generate like SECRET_KEY.
MODEL_SERVER_TOKEN=

# --- Camera passwords ---------------------------------------------------------------
# Encrypts camera passwords in the database. Set it on a new install:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key derived from SECRET_KEY is used. Changing it later makes stored camera
# passwords unreadable (re-enter them).
CAMERA_CREDENTIALS_KEY=

# --- Optional (defaults shown) ------------------------------------------------------
# Set both to 1 when the site is served over HTTPS.
# AUTH_COOKIE_SECURE=0
# CSRF_COOKIE_SECURE=0
# AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=
# AUTH_ACCESS_COOKIE_AGE=900
# AUTH_REFRESH_COOKIE_AGE=604800
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_LOCK_MINUTES=15
# USE_REDIS_CHANNEL_LAYER=0
# THROTTLE_ANON=120/hour
# THROTTLE_USER=1500/hour
# THROTTLE_AUTH_LOGIN=20/hour
# THROTTLE_AUTH_REFRESH=60/hour
# THROTTLE_AUTH_REGISTER=25/hour
# THROTTLE_AUTH_GRANT_TOKEN=50/hour
# THROTTLE_AUTH_ROLE_GRANT=80/hour
# THROTTLE_AUTH_GUEST_MANAGE=200/hour
