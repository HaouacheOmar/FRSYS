# Copy to docker/.env (git-ignored) and fill in. Used by docker-compose.yml.

# --- How browsers reach the app ------------------------------------------------------
# Port published on this PC (nginx). The posts open http://<this PC's IP>[:CLIENT_PORT].
CLIENT_PORT=80
# Exactly what the posts type in the address bar (scheme + host [+ :port if not 80]), comma-separated.
# Used for CORS/CSRF and the WebSocket origin check: a missing address can't log in or stream.
SITE_ORIGINS=http://localhost,http://192.168.1.100
# Host names / IPs of this PC, without scheme or port.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

# --- Secrets (generate each: python -c "import secrets; print(secrets.token_urlsafe(50))") ---
SECRET_KEY=
MODEL_SERVER_TOKEN=
# Camera password encryption key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_CREDENTIALS_KEY=

# --- Database (the db container is created with these) -------------------------------
DB_NAME=frsys
DB_USER=frsys
DB_PASSWORD=

DEBUG=0
